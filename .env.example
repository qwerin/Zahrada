# Zkopíruj jako .env (lokálně) nebo vlož do Environment variables stacku v Portaineru.

# ── Infrastruktura ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=zmen_toto_na_silne_heslo
# Image z GHCR: dev stack main, produkce latest (nebo pevná verze, např. 0.3.0)
APP_TAG=latest
# APP_IMAGE=ghcr.io/qwerin/zahrada
# Jen bez Traefiku:
APP_PORT=8080
# APP_BIND=0.0.0.0

# Jen pro docker-compose.traefik.yml:
# DOMAIN=zahrada.example.cz
# ROUTER=zahrada
# CERT_RESOLVER=letsencrypt
# TRAEFIK_NETWORK=proxy

# ── Aplikace (SPEC §5) ───────────────────────────────────────────────────────────
ZAHRADA_PUBLIC_URL=http://localhost:8080
ZAHRADA_TIMEZONE=Europe/Prague
# Od fáze F0 (převzato z NanoFaktury):
# ZAHRADA_SETUP_TOKEN=          # openssl rand -hex 16 — chrání první registraci
# ZAHRADA_SECRET_KEY=           # openssl rand -base64 32 — šifruje API token NanoFaktury
# ZAHRADA_ADMIN_EMAILS=
# ZAHRADA_SMTP_HOST=
# ZAHRADA_SMTP_USER=
# ZAHRADA_SMTP_PASSWORD=
# ZAHRADA_MAIL_FROM="Zahrada <zahrada@example.cz>"
